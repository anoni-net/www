{% extends "_layout.html.j2" %}
{% from "_doc.html.j2" import toc_mobile, toc_aside with context %}
{% set items = body|toc %}
{% block main %}
<div class="doc{% if items|length >= 2 %} has-toc{% endif %}">
<div class="doc-main">
<p class="crumb"><a href="{{ page_url('projects/reports') }}">{{ page.crumb }}</a>{{ icon('chevron-right') }}</p>
<h1>{{ page.title }}</h1>
<p class="post-date">{{ page.since.strftime('%Y/%m/%d') }} – {{ page.until.strftime('%m/%d') }} · <time datetime="{{ page.date.isoformat() }}">{{ page.date.strftime('%Y/%m/%d') }}</time></p>
{% if page.lead is defined %}
<p class="lead">{{ page.lead }}</p>
{% endif %}
{{ toc_mobile(items) }}
<div class="prose">
{{ body }}
</div>
<p><a class="more" href="{{ page_url('projects/reports') }}">{{ page.crumb }} {{ icon('arrow-right') }}</a></p>
</div>
{{ toc_aside(items) }}
</div>
{% endblock %}
