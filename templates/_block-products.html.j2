{# 內容專案的卡片。整張卡片可以點，卡片裡的最新文章與語系另外是連結，疊在上面。
   語系名稱用各自的寫法，三個語系的頁面都一樣。 #}
{% set lang_names = {'zh-TW': '正體中文', 'zh-CN': '简体中文', 'en': 'English'} %}
<div class="cards">
{% for p in data.projects.content %}
{% set items = latest(p.product, data.projects.content_latest) if data.projects.content_latest else [] %}
  <div class="card">
    <div class="card-h">
      <span class="ic">{{ icon(p.icon) }}</span>
      <span><a class="n" href="{{ docs_url() if p.product == 'docs' else news_url() }}">{{ pick(p.name) }}</a><span class="p">{{ p.display }}</span></span>
    </div>
    <p>{{ pick(p.summary) }}</p>
{% if items %}
    <ul class="card-latest" aria-label="{{ t.latest_posts }}">
{% for i in items %}
      <li><time datetime="{{ i.date }}">{{ i.date.strftime('%m/%d') }}</time><a href="{{ i.link }}">{{ i.title }}</a></li>
{% endfor %}
    </ul>
{% endif %}
    <div class="tags">{% for l in langs %}<a href="{{ product_url(p.product, l) }}" lang="{{ l.html }}"{% if l.code == lang.code %} aria-current="true"{% endif %}>{{ lang_names[l.code] }}</a>{% endfor %}{% if p.about %}<a class="about" href="{{ docs_url(p.about) if p.product == 'docs' else news_url(p.about) }}">{{ t.about_project }}</a>{% endif %}</div>
  </div>
{% endfor %}
</div>
