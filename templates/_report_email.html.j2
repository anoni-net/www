{# 觀測季報的電子報版本。信件程式大多不顯示 SVG，遠端圖片又會回傳開信紀錄，所以圖表全部用表格與底色畫，
   樣式直接寫在標籤上。v 是 reports.view() 的結果，L 是 data/reports.toml 的文字，cname 是地區名稱。
   tools/report_email.py 把每個 macro 各輸出一份，貼進 mail-mass 的信件模板。 #}
{% set C_STRONG = '#003e57' %}{% set C_TEXT = '#1d2b31' %}{% set C_MUTED = '#52646b' %}
{% set C_BAR = '#009ee6' %}{% set C_ME = '#006d99' %}{% set C_TRACK = '#e0f4ff' %}{% set C_LIGHT = '#4dbfff' %}

{% macro bar(pct, color) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr>
{%- set w = [[pct, 1] | max, 100] | min | round(1) %}
<td width="{{ w }}%" height="10" bgcolor="{{ color }}" style="background:{{ color }};height:10px;font-size:0;line-height:0;">&nbsp;</td>
{%- if w < 100 %}<td height="10" bgcolor="{{ C_TRACK }}" style="background:{{ C_TRACK }};height:10px;font-size:0;line-height:0;">&nbsp;</td>{% endif -%}
</tr></table>
{%- endmacro %}

{% macro stats() %}
{% set r = v.relays %}
{% set tw = (v.density | selectattr('code', 'equalto', cc) | first) %}
{% set t2 = (v.top2 | selectattr('code', 'equalto', cc) | first) %}
{% set cards = [
  (L.em_relays, r.end.running | string, L.at_start ~ ' ' ~ r.start.running),
  (L.em_density, '%.1f' | format(tw.value), cname['hk'] ~ ' ' ~ '%.1f' | format((v.density | selectattr('code', 'equalto', 'hk') | first).value)),
  (L.em_top2, '%.0f%%' | format(t2.pct), v.asn_share[0].asn ~ ' · ' ~ v.asn_share[0].n ~ ' / ' ~ r.end.running),
  (L.em_upgrade, '%.0f%%' | format(v.upgrade_cc.pct), v.upgrade_cc.on_new ~ ' / ' ~ v.upgrade_cc.total),
] %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;border-spacing:8px;margin:0 0 8px -8px;">
{% for row in cards | batch(2) %}
<tr>
{% for label, value, note in row %}
<td width="50%" valign="top" bgcolor="{{ C_TRACK }}" style="background:{{ C_TRACK }};border-radius:6px;padding:10px 12px;">
<div style="font-size:12px;color:{{ C_MUTED }};">{{ label }}</div>
<div style="font-size:26px;font-weight:bold;color:{{ C_STRONG }};line-height:1.3;">{{ value }}</div>
<div style="font-size:12px;color:{{ C_MUTED }};">{{ note }}</div>
</td>
{% endfor %}
</tr>
{% endfor %}
</table>
{% endmacro %}

{% macro regions() %}
{# region_rows 是 [(地區代碼, 季末中繼數)]，由大到小，tools/report_email.py 依 data/reports.toml 的 email_regions 算好 #}
{% set top = (region_rows | map(attribute=1) | max) or 1 %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 16px;">
<tr><td colspan="3" style="font-size:13px;font-weight:bold;color:{{ C_STRONG }};padding:0 0 8px;">{{ L.em_regions }}</td></tr>
{% for c in region_rows %}
{% set me = c[0] == cc %}
<tr>
<td width="72" style="font-size:13px;color:{{ C_STRONG if me else C_TEXT }};{{ 'font-weight:bold;' if me }}padding:3px 8px 3px 0;white-space:nowrap;">{{ cname[c[0]] }}</td>
<td style="padding:3px 0;">{{ bar(c[1] / top * 100, C_ME if me else C_BAR) }}</td>
<td width="44" align="right" style="font-size:13px;color:{{ C_STRONG if me else C_TEXT }};{{ 'font-weight:bold;' if me }}padding:3px 0 3px 8px;white-space:nowrap;">{{ c[1] }}</td>
</tr>
{% endfor %}
</table>
{% endmacro %}

{% macro types() %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 16px;">
<tr><td colspan="3" style="font-size:13px;font-weight:bold;color:{{ C_STRONG }};padding:0 0 4px;">{{ L.em_types }}</td></tr>
<tr><td colspan="3" style="font-size:12px;color:{{ C_MUTED }};padding:0 0 8px;"><span style="color:{{ C_LIGHT }};">■</span> {{ L.col_users }}　<span style="color:{{ C_ME }};">■</span> {{ L.col_measured }}</td></tr>
{% for t in v.types %}
<tr>
<td width="96" rowspan="2" valign="middle" style="font-size:13px;color:{{ C_TEXT }};padding:4px 8px 4px 0;border-bottom:1px solid {{ C_TRACK }};">{{ t.label }}</td>
<td style="padding:4px 0 1px;">{{ bar(t.users, C_LIGHT) }}</td>
<td width="52" align="right" style="font-size:12px;color:{{ C_TEXT }};padding:4px 0 1px 8px;white-space:nowrap;">{{ '%.1f%%' | format(t.users) }}</td>
</tr>
<tr>
<td style="padding:1px 0 4px;border-bottom:1px solid {{ C_TRACK }};">{{ bar(t.measured, C_ME) }}</td>
<td width="52" align="right" style="font-size:12px;color:{{ C_TEXT }};padding:1px 0 4px 8px;white-space:nowrap;border-bottom:1px solid {{ C_TRACK }};">{{ '%.1f%%' | format(t.measured) }}</td>
</tr>
{% endfor %}
</table>
{% endmacro %}
