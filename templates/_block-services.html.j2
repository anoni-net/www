<div class="svc">
{% for svc in data.services.services %}
  <article{% if svc.cat is defined %} class="cat-{{ svc.cat }}"{% endif %}>
    <h3><span class="ic">{{ icon(svc.icon) }}</span><a href="{{ service_url(svc) }}">{{ svc.name }}</a><small>{{ pick(svc.kind) }}</small></h3>
    <p>{{ pick(svc.summary) }}</p>
    <div class="tags"><span>{{ pick(svc.account) }}</span>{% if svc.onion %}<span>{{ t.onion }}</span>{% endif %}</div>
  </article>
{% endfor %}
</div>
